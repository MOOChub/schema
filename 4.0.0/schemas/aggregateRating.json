{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/moochub/4.0.0/schemas/aggregateRating.json",
  "title": "Aggregate rating",
  "description": "An aggregate rating for a course based on ratings from multiple providers or users.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ratingValue": {
      "type": "number",
      "minimum": 0
    },
    "ratingCount": {
      "type": "integer",
      "minimum": 0
    },
    "bestRating": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "worstRating": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": ["ratingValue", "ratingCount", "bestRating", "worstRating"]
}
