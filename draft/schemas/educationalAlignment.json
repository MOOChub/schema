{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/moochub/draft/schemas/educationalAlignment.json",
  "title": "Educational alignment",
  "description": "An alignment to an established educational framework. It is recommended to use one of the specialized alignment schemas for specific frameworks, e.g. iscedFAlignment, oefosAlignment, hochschulfaechersystematikAlignment, schulfaecherAlignment or hollandCodesAlignment, but other frameworks may be alligned as well.",
  "type": "array",
  "minItems": 1,
  "uniqueItems": true,
  "items": {
    "anyOf": [
      {
        "$ref": "https://w3id.org/moochub/draft/schemas/alignmentObject.json"
      },
      {
        "$ref": "https://w3id.org/moochub/draft/schemas/iscedFAlignment.json"
      },
      {
        "$ref": "https://w3id.org/moochub/draft/schemas/oefosAlignment.json"
      },
      {
        "$ref": "https://w3id.org/moochub/draft/schemas/hochschulfaechersystematikAlignment.json"
      },
      {
        "$ref": "https://w3id.org/moochub/draft/schemas/schulfaecherAlignment.json"
      },
      {
        "$ref": "https://w3id.org/moochub/draft/schemas/hollandCodesAlignment.json"
      }
    ]
  }
}
