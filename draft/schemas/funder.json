  "$id": "https://w3id.org/moochub/draft/schemas/funder.json",
  "title": "Funder",
  "description": "A person or organization that supports or supported a learning resource or educational program through a financial contribution.",
  "type": "array",
  "uniqueItems": true,
  "minItems": 1,
  "items": {
    "anyOf": [
      {
        "$ref": "https://w3id.org/moochub/draft/schemas/organization.json"
      },
      {
        "$ref": "https://w3id.org/moochub/draft/schemas/person.json"
      }
    ]
  }
}
