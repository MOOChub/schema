{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/moochub/draft/schemas/schulfaecherAlignment.json",
  "title": "Schulfächer AlignmentObject",
  "description": "An AlignmentObject for the Schulfächer framework.",
  "allOf": [
    {
      "$ref": "https://w3id.org/moochub/draft/schemas/alignmentObject.json"
    },
    {
      "type": "object",
      "properties": {
        "alignmentType": {
          "const": "educationalSubject"
        },
        "educationalFramework": {
          "const": "Schulfächer"
        },
        "targetUrl": {
          "$ref": "https://w3id.org/moochub/draft/schemas/url.json",
          "pattern": "^http://w3id.org/kim/schulfaecher/.*$"
        }
      },
      "required": ["targetUrl"]
    }
  ]
}
