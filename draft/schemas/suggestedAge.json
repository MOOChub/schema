{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/moochub/draft/schemas/suggestedAge.json",
  "title": "Suggested age",
  "description": "The recommended age of the target audience for the course.",
  "type": "object",
  "properties": {
    "minValue": {
      "title": "minValue",
      "type": "integer",
      "min": 0
    },
    "maxValue": {
      "title": "maxValue",
      "type": "integer",
      "min": 0
    }
  },
  "anyOf": [
    {
      "required": ["minValue"]
    },
    {
      "required": ["maxValue"]
    }
  ]
}
